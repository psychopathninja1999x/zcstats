APP_NAME="Everything, Zamboanga"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=zcstats
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OPENWEATHER_API_KEY=
OPENWEATHER_LAT=6.9214
OPENWEATHER_LON=122.079

ZCWD_WATER_URL=https://zcwd.gov.ph/production_new_bak.php
ZCWD_WATER_CACHE_SECONDS=900
# Set to false only if PHP cannot verify TLS (e.g. missing CA bundle on some Windows dev setups). Prefer fixing the CA store in production.
ZCWD_VERIFY_SSL=true

ZAMCELCO_POWER_RATES_API_URL=https://consumers.zamcelco.com.ph/api/v1/mobile/power-rates
ZAMCELCO_CACHE_SECONDS=3600
ZAMCELCO_VERIFY_SSL=true

# MetroFuel Tracker — https://metrofueltracker.com/ (public /api/stations; bbox must match a region MetroFuel has mapped)
METROFUEL_BASE_URL=https://metrofueltracker.com
METROFUEL_NORTH=7.6108
METROFUEL_SOUTH=6.9512
METROFUEL_EAST=125.7022
METROFUEL_WEST=125.2126
METROFUEL_REGION_LABEL="Metro Davao (Davao City area)"
METROFUEL_DISCLAIMER="MetroFuel does not list Zamboanga City yet. Prices are community reports from the mapped region below."
METROFUEL_CACHE_SECONDS=1800
METROFUEL_VERIFY_SSL=true

# PCSO Lotto — optional JSON first (PCSO_LOTTO_API_URL), else scrape PCSO_LOTTO_PAGE_URL (default LottoPCSO)
# PCSO_LOTTO_API_URL=
PCSO_LOTTO_ENABLED=true
PCSO_LOTTO_PAGE_URL=https://www.lottopcso.com/
# PCSO_LOTTO_SEARCH_URL=   # legacy alias for PCSO_LOTTO_PAGE_URL
# PCSO_LOTTO_PCSO_OFFICIAL_URL=https://www.pcso.gov.ph/SearchLottoResult.aspx
PCSO_LOTTO_CACHE_SECONDS=3600
PCSO_LOTTO_CAROUSEL_MAX=15
PCSO_LOTTO_VERIFY_SSL=true
